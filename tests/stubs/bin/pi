#!/bin/sh
# Stub `pi` for the smoke tests. `pi install ...` succeeds as a no-op so the
# pi-llama plugin step is exercised without installing anything.
LOG="${PI_STUB_LOG:-/tmp/pi-stub.log}"
echo "pi $*" >> "$LOG"
case "$1" in
  install) echo "stub: pi-llama plugin installed (no-op)"; exit 0 ;;
  *) exit 0 ;;
esac
