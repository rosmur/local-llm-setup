#!/bin/sh
# Stub `llama` for the smoke tests. Reports "already installed" so
# setup-local-llm.sh never attempts a real install/download; logs every
# invocation so the test can prove the real binary was never used.
LOG="${LLAMA_STUB_LOG:-/tmp/llama-stub.log}"
echo "llama $*" >> "$LOG"
case "$1" in
  cli)
    case "$2" in
      --help) printf '%s\n' "-no-cnv" "--single-turn" "--no-warmup" ;;
    esac
    exit 0
    ;;
  serve)    exit 0 ;;
  --version) echo "llama-stub 0.0.0 (smoke)"; exit 0 ;;
  *) exit 0 ;;
esac
